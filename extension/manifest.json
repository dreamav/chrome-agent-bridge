{
  "manifest_version": 3,
  "name": "Chrome Agent Bridge",
  "version": "1.4.0",
  "description": "Автономный менеджер сессий и групп вкладок Google Chrome (0% CPU, Session Buddy style)",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "downloads",
    "contextMenus",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
